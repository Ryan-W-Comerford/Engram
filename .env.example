# ═══════════════════════════════════════════════════════════════════════════════
# Engram configuration. Copy to .env and fill in the two AI keys — everything
# else has working defaults for a local single-machine run.
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── AI APIs (the only required values) ────────────────────────────────────────
# Claude — incident analysis. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — incident similarity embeddings (text-embedding-3-small, ~$0.02 / 1M
# tokens, effectively free at this scale). https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the Claude model used for analysis.
CLAUDE_MODEL=claude-sonnet-4-6

# ── Access control (optional) ────────────────────────────────────────────────
# Leave AUTH_TOKEN blank and Engram runs wide open — no dashboard login, no
# token on /ingest. Fine for localhost or a private network.
#
# Set it to any string to require that token everywhere:
#   • dashboard shows a one-field login
#   • SDK:  Engram(host="...", token="<AUTH_TOKEN>")
#   • OTel: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <AUTH_TOKEN>
#           (also swap in otel-collector-config.auth.yaml — see docker-compose.yml)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_TOKEN=

# Only used to sign the dashboard login cookie, and only when AUTH_TOKEN is set.
# Set to a fixed value so logins survive a restart.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=

# Set to 1 when serving the dashboard over HTTPS (marks the login cookie Secure).
HTTPS=0

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=engram_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Alembic migration URL — point at the direct Postgres port to bypass PgBouncer
# or managed poolers. Leave empty in local dev (falls back to DATABASE_URL).
MIGRATIONS_DATABASE_URL=

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Local dev: leave all KAFKA_SECURITY_PROTOCOL / SASL vars blank.
#
# Managed Kafka (Confluent Cloud / AWS MSK / Upstash):
#   KAFKA_BOOTSTRAP_SERVERS=pkc-xxx.us-east-1.aws.confluent.cloud:9092
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_MECHANISM=PLAIN
#   KAFKA_SASL_USERNAME=<API key>
#   KAFKA_SASL_PASSWORD=<API secret>
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Persistent sliding-window state for the anomaly detector. If unset, falls back
# to an in-memory aggregator (state lost on restart).
REDIS_URL=redis://redis:6379/0

# ── Alerts (optional — configure either, both, or neither) ────────────────────
# Slack: api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Email via SendGrid: app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=you@yourdomain.com

# ── URLs ─────────────────────────────────────────────────────────────────────
# Dashboard URL used in alert links.
DASHBOARD_BASE_URL=http://localhost:8080

# Ingestor URL shown on the dashboard settings page for SDK setup.
INGESTOR_HOST=http://localhost:8000
