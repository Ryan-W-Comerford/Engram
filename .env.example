# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=pulseai_dev

# Connection pool — each service opens pool_size persistent connections plus
# up to max_overflow burst connections. With 3 services × (5+10)=15 each,
# keep max_connections ≥ 50; the compose file sets it to 200 for headroom.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Alembic migration URL — point at the direct Postgres port to bypass PgBouncer
# or managed poolers (which don't support DDL inside transactions).
# Leave empty in local dev (falls back to DATABASE_URL).
MIGRATIONS_DATABASE_URL=

# ── Admin API ─────────────────────────────────────────────────────────────────
# Required: protects POST /projects (project creation). Must be set in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Required: Claude for incident analysis
ANTHROPIC_API_KEY=sk-ant-...

# Required: OpenAI for incident similarity embeddings
# text-embedding-3-small costs $0.02 / 1M tokens — effectively free at MVP scale
# Get from: platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the Claude model used for incident analysis
# Defaults to claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# ── Dashboard auth ────────────────────────────────────────────────────────────
# Required: signs the session cookie. Must be set in production — without it,
# sessions are re-keyed on every restart and everyone gets logged out.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=

# Set to 1 when serving over HTTPS — required in production (Caddy handles TLS)
HTTPS=1

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Local dev: leave all KAFKA_SECURITY_PROTOCOL / SASL vars blank.
#
# Managed Kafka (Confluent Cloud / AWS MSK / Upstash):
#   KAFKA_BOOTSTRAP_SERVERS=pkc-xxx.us-east-1.aws.confluent.cloud:9092
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_MECHANISM=PLAIN
#   KAFKA_SASL_USERNAME=<API key>
#   KAFKA_SASL_PASSWORD=<API secret>
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by the processor for persistent sliding window state.
# Defaults to the redis service in docker-compose; override for managed Redis.
# If unset, falls back to an in-memory aggregator (state lost on restart).
# Managed example: redis://:password@redis-host.cloud:6379/0
REDIS_URL=redis://redis:6379/0

# ── OTel Collector bearer token ───────────────────────────────────────────────
# Required in production — if empty, the collector accepts ANY bearer token (no auth)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
OTEL_BEARER_TOKEN=

# ── Alerts (configure either or both — both are optional) ─────────────────────

# Slack: get from api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Email via SendGrid: app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=you@yourdomain.com

# ── Dashboard public URL (used in alert links) ────────────────────────────────
DASHBOARD_BASE_URL=http://localhost:8080

# ── Ingestor public URL (shown on the settings page for webhook + SDK setup) ──
# Local dev: http://localhost:8000 (default)
# Production: set to your public-facing ingestor URL, e.g. https://ingestor.yourdomain.com
INGESTOR_HOST=http://localhost:8000

# ── GitHub webhook ────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
